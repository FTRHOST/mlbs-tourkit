{
  "name": "mlbs-tourkit-unified",
  "version": "2.0.0",
  "description": "Unified Mobile Legends Broadcasting System",
  "scripts": {
    "setup": "npm install && cd desktop-server && npm install && cd ../overlay-MLBB && npm install",
    "build": "cd overlay-MLBB && npm run build",
    "start": "concurrently --kill-others \"npm run start:server\" \"npm run start:web\"",
    "start:server": "cd desktop-server && npm run start",
    "start:web": "cd overlay-MLBB && npm run dev -- --host",
    "mlbs": "concurrently --kill-others \"cd desktop-server && npm run build && npm run start\" \"cd overlay-MLBB && npm run dev -- --host\"",
    "test": "cd desktop-server && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^8.2.2",
    "socket.io-client": "^4.8.3",
